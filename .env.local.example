# Copy to .env.local (gitignored). Used by scripts/ and web/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# OpenAI
OPENAI_API_KEY=your-openai-key-here
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Required in production: protects keepalive and alert cron endpoints.
CRON_SECRET=replace-with-a-long-random-secret

# Optional alert digest channels
RESEND_API_KEY=
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=alerts@your-verified-domain.com
DISCORD_WEBHOOK_URL=
# Set to true only if the webhook points at a FORUM channel. New/Contacted
# factories sourced by a network share its thread; Replied+ factories get their
# own thread. Leave blank/false for a normal Text channel.
DISCORD_FORUM=
# Legacy forum-mode hint only; no longer rendered in thread titles.
# Prefer DISCORD_FORUM=true for new setups.
DISCORD_THREAD_NAME=
# Base URL used for deep links in Discord alerts (defaults to the Vercel URL)
APP_URL=https://minder-leads.vercel.app
