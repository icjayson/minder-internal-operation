{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "minder-leads-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "minder-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
