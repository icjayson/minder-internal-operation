{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "devCommand": "npm --prefix web run dev",
  "outputDirectory": "web/.next",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 12 * * 1,4"
    },
    {
      "path": "/api/scan-alerts",
      "schedule": "0 1 * * *"
    }
  ]
}
